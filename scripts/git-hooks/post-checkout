#!/bin/sh
#
# HelloKahwin shared-repo boundary guard  (RISK-09)
#
# hellokahwin (the company record: docs, plans, work-done, boardroom, fixtures)
# and hellokahwin-site (the Next.js source) are ONE git repository. Same remote,
# same root commit 3a1fbe09. Nothing but convention keeps them apart.
#
# A single `git checkout master` in the docs tree replaces the company record
# with the site source on disk. This hook makes that operation fail.
#
# Space is decided by TREE CONTENT, never by branch name: `docs/plat-10-11-12`
# is a site-space branch and `feat/command-centre-dashboard` is a docs-space
# branch, so any name-based rule is wrong on day one.
#
# Deliberate override:  HK_GIT_SPACE_GUARD=off git checkout <ref>
#
# Source of truth: scripts/git-hooks/post-checkout on the hellokahwin docs
# branch. Installed with scripts/git-hooks/install-hooks.sh. Do not edit the
# copy in .git/hooks -- it is overwritten on the next install.

set -u

prev_head="${1:-}"
new_head="${2:-}"
branch_switch="${3:-0}"

# Only branch/commit switches. Flag 0 is a file checkout (`git checkout -- p`).
[ "$branch_switch" = "1" ] || exit 0

# Re-entry from this hook's own restore checkout, or a deliberate override.
case "${HK_GIT_SPACE_GUARD:-}" in
  off|OFF|0) exit 0 ;;
esac

NULL_SHA="0000000000000000000000000000000000000000"
[ -n "$prev_head" ] && [ -n "$new_head" ] || exit 0
[ "$prev_head" != "$NULL_SHA" ] || exit 0   # initial checkout of a fresh clone
[ "$prev_head" != "$new_head" ] || exit 0   # `git checkout -b` on the same commit

# --- classify a commit into a space, by content --------------------------------
hk_space() {
  if git cat-file -e "$1:next.config.ts" 2>/dev/null; then
    echo site
  elif git cat-file -e "$1:docs/boardroom" 2>/dev/null \
    || git cat-file -e "$1:frontend" 2>/dev/null; then
    echo docs
  else
    echo unknown
  fi
}

from_space=$(hk_space "$prev_head")
to_space=$(hk_space "$new_head")

# Fail open on anything we cannot confidently classify. A guard that fires on
# commits it does not understand is a guard people delete.
[ "$from_space" != "unknown" ] && [ "$to_space" != "unknown" ] || exit 0
[ "$from_space" != "$to_space" ] || exit 0

# --- we are across the boundary: refuse ----------------------------------------
short_prev=$(git rev-parse --short "$prev_head" 2>/dev/null || echo "$prev_head")
short_new=$(git rev-parse --short "$new_head" 2>/dev/null || echo "$new_head")
new_name=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$short_new")
# A detached checkout reports the literal string HEAD, which would make the
# override hint below a no-op. Name the commit instead.
[ "$new_name" = "HEAD" ] && new_name="$short_new"

echo "" >&2
echo "==============================================================================" >&2
echo "  REFUSED: this checkout crosses the hellokahwin docs/site boundary." >&2
echo "==============================================================================" >&2
echo "" >&2
echo "  from: $from_space space   $short_prev" >&2
echo "  to:   $to_space space   $short_new  ($new_name)" >&2
echo "" >&2
echo "  hellokahwin (docs) and hellokahwin-site are the SAME repository - same" >&2
echo "  remote, same root commit 3a1fbe09 - kept apart only by convention. This" >&2
echo "  switch replaces the contents of this working tree with the other space." >&2
echo "" >&2

# Put the tree back. `git checkout -` returns to the ref we came from, so a
# branch stays a branch rather than becoming a detached HEAD.
restore_out=$(HK_GIT_SPACE_GUARD=off git checkout - 2>&1)
restore_rc=$?
now_head=$(git rev-parse HEAD 2>/dev/null || echo "")

if [ "$restore_rc" -eq 0 ] && [ "$now_head" = "$prev_head" ]; then
  echo "  RESTORED. You are back on $(git rev-parse --abbrev-ref HEAD) at $short_prev." >&2
  echo "  Nothing was lost. Work in the other tree instead:" >&2
  echo "    docs -> ~/Documents/Code/hellokahwin/hellokahwin" >&2
  echo "    site -> ~/Documents/Code/hellokahwin-site" >&2
else
  echo "  COULD NOT RESTORE AUTOMATICALLY. This tree is now in $to_space space." >&2
  echo "  git said: $restore_out" >&2
  echo "  Recover with:  HK_GIT_SPACE_GUARD=off git checkout $short_prev" >&2
fi

echo "" >&2
echo "  If you truly mean to cross the boundary in THIS tree:" >&2
echo "    HK_GIT_SPACE_GUARD=off git checkout $new_name" >&2
echo "==============================================================================" >&2
echo "" >&2

exit 1
