{
  // Type-check the SEO scripts, which `tsconfig.typecheck.json` excludes.
  //
  // `scripts/` was excluded because most of what lives there is a throwaway
  // probe. The four under `scripts/seo/` that UPDATE published editorial
  // content in production are not throwaway, and "no type-check covers this
  // file" is not a property those should have. Scoped to the files this batch
  // owns rather than all of `scripts/`, so it stays green instead of
  // inheriting years of untyped one-offs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  // The base config excludes `scripts`; an inherited `exclude` beats
  // `include`, so it is restated here without that entry.
  "exclude": ["node_modules", ".next"],
  "include": [
    "scripts/seo/_db.mts",
    "scripts/seo/_content-apply.mts",
    "scripts/seo/_content-images.mts",
    "scripts/seo/rewrite-internal-hrefs.mts",
    "scripts/seo/backfill-image-alt.mts",
    "scripts/seo/vision-alt.mts",
    "scripts/seo/apply-category-descriptions.mts",
    "scripts/seo/apply-meta-titles.mts",
    "scripts/seo/revalidate-production.mts",
    "scripts/seo/__tests__/content-images.test.ts"
  ]
}
