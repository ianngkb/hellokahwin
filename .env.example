# HelloKahwin environment — copy to .env and fill in real values.
# Next.js loads .env automatically; scripts load it via dotenv.

# Supabase Postgres (transaction pooler URL)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Clerk (admin auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=me@ian.ng

# Cloudflare R2 — article images bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hellokahwin-images
R2_PUBLIC_URL=https://images.hellokahwin.com
# Static assets bucket (optional; falls back to images bucket)
R2_ASSETS_BUCKET_NAME=hellokahwin-assets
R2_ASSETS_PUBLIC_URL=https://assets.hellokahwin.com
NEXT_PUBLIC_R2_ASSETS_PUBLIC_URL=https://assets.hellokahwin.com

# Smart crops (face/label-aware cropping).
# Set REKOGNITION_ENABLED=false to run without AWS at all: detection
# short-circuits to empty results and crops fall back to the Sharp saliency
# focal point. Leaving it unset/true REQUIRES all three AWS_REKOGNITION_* vars
# below — getRekognitionClient() throws without them and smart-crop generation
# fails for every image. Note the prefix: the code reads AWS_REKOGNITION_*,
# NOT the conventional AWS_* names.
REKOGNITION_ENABLED=false
AWS_REKOGNITION_REGION=ap-southeast-1
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=

# WP import source
WP_SOURCE_URL=https://hellokahwin.com

# Cron auth secret for /api/cron/* routes (Vercel Cron sends it as Bearer token)
CRON_SECRET=
