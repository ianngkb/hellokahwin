                "type": "bold"
              }
            ]
          },
          {
            "text": "Pasangan dari Putrajaya, Cyberjaya, Bangi atau Kajang yang mahu majlis grand ala ballroom hotel tetapi masih dalam bajet bawah RM5,000.",
            "type": "text"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
