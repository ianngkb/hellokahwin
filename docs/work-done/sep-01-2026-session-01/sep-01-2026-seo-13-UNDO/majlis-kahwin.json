          {
            "text": ".",
            "type": "text"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "text": "Pakej lengkap termasuk katering, ",
            "type": "text"
          },
          {
            "text": "pelamin",
