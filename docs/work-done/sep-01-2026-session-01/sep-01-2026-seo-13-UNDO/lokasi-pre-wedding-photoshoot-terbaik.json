      {
        "type": "image",
        "attrs": {
          "alt": "",
          "src": "https://images.hellokahwin.com/inspire/lokasi-pre-wedding-photoshoot-terbaik/1787396476788-19-996-tk-teo-photography-suki-oska-15_TKTP3352/high.webp",
          "title": null,
          "data-caption": "TK Teo Photography",
          "data-caption-url": null
        }
